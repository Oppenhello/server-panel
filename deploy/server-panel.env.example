# 复制到 /etc/server-panel.env，chmod 600
PANEL_PORT=3100
PANEL_HOST=127.0.0.1
PANEL_USER=admin
# 必填：没有这一项服务会拒绝启动
PANEL_PASS=change-me-please
# 静态文件目录（nginx 的 root 指向它）
PANEL_WEB=/var/www/panel
# 首页固定展示的单元（不存在也没关系，会自动补一条状态）
PANEL_WATCH=nginx.service,sshd.service,server-panel.service
# 可选：本机卡片上展示的地址；不填则用第一块网卡的地址
PANEL_PUBLIC_IP=
# 可选：远程主机清单路径
# PANEL_HOSTS=/etc/server-panel-hosts.json
